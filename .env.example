# Copy to .env.local before starting Next.js; .env.example is not loaded automatically.
# Local setup: NestJS API on port 3000, Next.js dashboard on port 3001.
# Server-side only. Replace with the actual API URL; no credentials or secrets.
API_BASE_URL=http://localhost:3000

# Exact public dashboard origin, used for CSRF checks and safe redirects.
# Production example: https://dashboard.example.com (serve over HTTPS).
APP_ORIGIN=http://localhost:3001
